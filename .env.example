# Copy this file to .env.local and fill in the keys you have, then restart `npm run dev`.
# With no keys at all the studio still works end to end using offline placeholder models.

# --- fal.ai: one key for Seedance 2.0, Kling 3, Veo 3.1, Wan 3.0, Seedream 5, ElevenLabs ---
# https://fal.ai/dashboard/keys
FAL_KEY=

# --- Volcengine Ark (ByteDance, China): Seedance 2.0 video, Seedream image, Doubao LLM ---
# https://console.volcengine.com/ark  (API Key management)
ARK_API_KEY=
# China region (default). For BytePlus ModelArk (international) use:
#   ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
#   and override the model ids below with the BytePlus names from your console.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional model-id overrides (defaults shown)
# ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
# ARK_VIDEO_FAST_MODEL=doubao-seedance-2-0-fast-260128
# ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
# ARK_LLM_MODEL=doubao-seed-2-0-lite-260215

# --- Claude: turns a script into a shot list (characters, shots, prompts, dialogue) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Which engine breaks scripts into shots: auto | claude | ark | rules
# auto = Claude if ANTHROPIC_API_KEY is set, else Doubao if ARK_API_KEY is set, else the offline rule-based splitter.
LLM_PROVIDER=auto

# Optional: explicit ffmpeg/ffprobe paths if they are not on PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
